#!/bin/sh
set -eu
PATH=/usr/bin:/bin:/usr/sbin:/sbin
export PATH
mkdir -p /usr/local/bin
target=/usr/local/bin/tunnelctl
if [ -e "$target" ] || [ -L "$target" ]; then
    if [ ! -L "$target" ] || [ "$(readlink "$target")" != '/Library/Application Support/tunnelctl/tunnelctl' ]; then
        echo 'Command path changed during installation; refusing to overwrite it.' >&2
        exit 1
    fi
else
    ln -s '/Library/Application Support/tunnelctl/tunnelctl' "$target"
fi
